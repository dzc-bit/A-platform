# Docker Compose and FastAPI configuration. Copy this file to .env before starting.
# Native FastAPI uses backend/data/business_ai.db by default. Compose always injects
# its container path; set COMPOSE_DATABASE_URL only when intentionally overriding it.
COMPOSE_DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_SECRET=replace-with-a-long-random-secret-before-production
TOKEN_TTL_SECONDS=28800
DEMO_PASSWORD=replace-with-a-local-demo-password

# Optional OpenAI-compatible provider. Leave LLM_API_KEY empty for the local demo path.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional image-understanding model. Leave empty to keep image analysis in safe fallback mode.
LLM_VISION_MODEL=

# Optional Redis retrieval cache for a native backend. Docker Compose supplies its
# own redis://redis:6379/0 default when this value is empty.
REDIS_URL=
REDIS_KEY_PREFIX=business-ai

# Optional Dify application gateway. Leave the values empty for local fallback.
# TTS/image keys may point at separately published Dify apps; when left empty,
# the backend deliberately falls back to DIFY_API_KEY, then returns 503 if no
# usable key is available. Media URLs can be restricted to approved host names
# with a comma-separated allowlist (for example, media.example.com).
DIFY_API_URL=
DIFY_API_KEY=
DIFY_TTS_API_KEY=
DIFY_IMAGE_API_KEY=
DIFY_MEDIA_ALLOWED_HOSTS=

# Dify router workflow: the entry-point workflow that classifies user requests
# and routes simple queries to Dify knowledge base, complex tasks to LangGraph
# callback, and media requests to TTS/image tools.
# DIFY_ROUTER_API_KEY is the API key of the published router workflow app.
# DIFY_CALLBACK_SECRET is a shared secret for the Dify HTTP callback node to
# authenticate against the internal /api/v1/tools/langgraph/run endpoint.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DIFY_ROUTER_API_KEY=
DIFY_CALLBACK_SECRET=
DIFY_ROUTER_TIMEOUT_SECONDS=150
